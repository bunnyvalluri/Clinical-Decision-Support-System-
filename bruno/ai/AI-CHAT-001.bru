meta {
  name: AI-CHAT-001
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/ai/chat/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{doctor_access_token}}
}

body:json {
  {
    "message": "Summarize sepsis guideline indicators for patient risk protocol.",
    "context": {
      "patient_id": "{{test_patient_id}}"
    }
  }
}

assert {
  res.status: in [200, 400, 401, 503]
}
