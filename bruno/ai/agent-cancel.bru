meta {
  name: AI-AGENT-CANCEL-001
  type: http
  seq: 13
}

post {
  url: {{base_url}}/api/v1/ai/agents/executions/{{execution_id}}/cancel/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{doctor_access_token}}
}

assert {
  res.status: in [200, 400, 401, 403, 404]
}
