meta {
  name: AUTH-REFRESH-001
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/token/refresh/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "refresh": "{{test_refresh_token}}"
  }
}

assert {
  res.status: in [200, 400, 401]
}
