meta {
  name: AUTH-LOGOUT-001
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/auth/logout/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{doctor_access_token}}
}

body:json {
  {
    "refresh": "{{test_refresh_token}}"
  }
}

assert {
  res.status: in [200, 204, 400, 401]
}
