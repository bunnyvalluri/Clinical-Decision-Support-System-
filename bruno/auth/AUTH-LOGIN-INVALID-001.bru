meta {
  name: AUTH-LOGIN-INVALID-001
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/login/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "username": "nonexistent_test_user",
    "password": "WrongTestPassword123!"
  }
}

assert {
  res.status: eq 401
}
