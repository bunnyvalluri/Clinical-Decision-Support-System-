meta {
  name: INFRA-GOVERNANCE-001
  type: http
  seq: 6
}

# Platform Governance: Policy checks, OpenTofu IaC plans, drift auditing, and cost governance
get {
  url: {{base_url}}/api/v1/infrastructure/governance/policies/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_access_token}}
}

assert {
  res.status: in [200, 401, 403]
}
