meta {
  name: INFRA-SERVERS-001
  type: http
  seq: 2
}

# Registered Docker host servers registry check
get {
  url: {{base_url}}/api/v1/infrastructure/servers/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_access_token}}
}

assert {
  res.status: in [200, 401, 403]
}
