meta {
  name: INFRA-HEALTH-001
  type: http
  seq: 1
}

# Coolify control plane health and circuit breaker status check
get {
  url: {{base_url}}/api/v1/infrastructure/health/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{admin_access_token}}
}

assert {
  res.status: in [200, 401, 403]
}
