meta {
  name: FHIR-PATIENT-GET-001
  type: http
  seq: 3
}

get {
  url: {{base_url}}/fhir/r4/Patient/{{test_patient_id}}
  body: none
  auth: bearer
}

headers {
  Accept: application/fhir+json
}

auth:bearer {
  token: {{doctor_access_token}}
}

assert {
  res.status: eq 200
  res.body.resourceType: eq Patient
}
