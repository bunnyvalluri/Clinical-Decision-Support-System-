meta {
  name: RBAC-NURSE-001
  type: http
  seq: 2
}

# Nurse attempting to modify Model Registry governance must receive 403 Forbidden
post {
  url: {{base_url}}/api/v1/models/versions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{nurse_access_token}}
}

body:json {
  {
    "model_name": "UnauthorizedModelMutation",
    "version": "9.9.9"
  }
}

assert {
  res.status: in [401, 403, 405]
}
