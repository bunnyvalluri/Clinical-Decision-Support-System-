meta {
  name: RBAC-DOCTOR-001
  type: http
  seq: 1
}

# Doctor attempting to access IT Administrator endpoints must receive 403 Forbidden
get {
  url: {{base_url}}/api/v1/admin/users/
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{doctor_access_token}}
}

assert {
  res.status: in [401, 403]
}
