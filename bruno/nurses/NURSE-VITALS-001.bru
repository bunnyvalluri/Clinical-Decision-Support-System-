meta {
  name: NURSE-VITALS-001
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/clinical/vitals/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{nurse_access_token}}
}

body:json {
  {
    "patient_id": "{{test_patient_id}}",
    "systolic_bp": 120,
    "diastolic_bp": 80,
    "heart_rate": 72,
    "temperature": 37.0,
    "oxygen_saturation": 98
  }
}

assert {
  res.status: in [200, 201, 400, 401, 404]
}
