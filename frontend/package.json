    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pocketbase": "^0.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "react-doctor": "^0.9.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
