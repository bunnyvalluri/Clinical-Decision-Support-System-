{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:routes": "node --test tests/roleRoutes.test.mjs",
    "test:pb": "node --test tests/pocketbase.test.mjs",
    "test:brand": "node --test tests/brand.test.mjs",
    "test:nocodb": "node --test tests/nocodb.test.mjs",
    "test": "node --test tests/roleRoutes.test.mjs tests/pocketbase.test.mjs tests/brand.test.mjs tests/nocodb.test.mjs",
    "doctor": "react-doctor --no-telemetry",
    "doctor:verbose": "react-doctor --verbose --no-telemetry",
    "doctor:changed": "react-doctor --scope changed --no-telemetry",
    "doctor:design": "react-doctor design --no-telemetry",
    "doctor:ci": "react-doctor --scope changed --blocking none --no-telemetry"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
