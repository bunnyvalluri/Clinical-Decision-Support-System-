[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    env,
    migrations,
    htmlcov,
    staticfiles,
    media,
    worktrees,
    security_workspaces,
    node_modules,
    scripts,
    verify_role_permissions.py
ignore =
    E203,
    E226,
    E231,
    E261,
    E266,
    E302,
    E303,
    E305,
    E401,
    E402,
    E501,
    F401,
    F403,
    F541,
    F811,
    F841,
    W291,
    W293,
    W391,
    W503
per-file-ignores =
    __init__.py:F401
