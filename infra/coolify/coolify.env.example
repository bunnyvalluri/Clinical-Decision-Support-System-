# Coolify Control Plane Environment Configuration Template
# COPY TO .env IN PRODUCTION OR INJECT VIA SECURE SECRET MANAGER
# NEVER COMMIT ACTUAL TOKENS OR PASSWORDS

COOLIFY_API_URL=http://localhost:8000/api/v1
COOLIFY_API_TOKEN=replace_with_server_side_bearer_token
COOLIFY_DEFAULT_SERVER_UUID=replace_with_coolify_server_uuid
COOLIFY_WEBHOOK_SECRET=replace_with_webhook_hmac_secret
COOLIFY_TIMEOUT_SECONDS=5
COOLIFY_CIRCUIT_BREAKER_MAX_FAILURES=3
COOLIFY_CIRCUIT_BREAKER_RESET_TIMEOUT=30
